{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./vite.json",
  "compilerOptions": {
    "strictNullChecks": true,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
