# URL de la app branch (la propia; el login redirige acá si el usuario es branch_admin)
VITE_BRANCH_URL=http://localhost:5175

# URL de la app admin global (el login redirige acá si el usuario es super_admin)
VITE_ADMIN_URL=http://localhost:5174

# URL de la app rider (el login redirige acá si el usuario es repartidor)
VITE_RIDER_URL=http://localhost:5176

# Si es true, RequireAuth mockea la sesión como branch_admin (no redirige al login).
# Útil para probar el admin de sucursal con mocks sin backend.
VITE_MOCK_AUTH=false
