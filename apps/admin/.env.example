# URL de la app branch (a la que redirige el login si el usuario es admin de sucursal)
VITE_BRANCH_URL=http://localhost:5175

# URL de la app rider (a la que redirige el login si el usuario es repartidor)
VITE_RIDER_URL=

# Si es true, RequireAuth mockea la sesión (no redirige al login). Para builds nativas.
VITE_MOCK_AUTH=false
