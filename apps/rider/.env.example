# Si es true, RequireAuth mockea la sesión como rider (no redirige al login).
VITE_MOCK_AUTH=false

# URL de la app admin global (el login redirige acá si el usuario es super_admin)
VITE_ADMIN_URL=http://localhost:5174

# API key de Geoapify para el mapa estático de ruta del viaje
VITE_GEOAPIFY_API_KEY=
