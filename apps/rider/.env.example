# ---------------------------------------------------------------------------
# Variables de entorno — app rider
#
# [Requerida]  Sin ella la app no funciona.
# [Opcional]   Tiene valor por defecto en el código (packages/auth/appConfig.ts).
# ---------------------------------------------------------------------------

# [Requerida] URL del backend (GraphQL gateway). En dev el proxy de Vite cae a
# http://localhost:4000 si no se define; en build/deploy es obligatoria.
VITE_API_URL=http://localhost:4000

# [Requerida para mapas] API key de Geoapify (geocoding + mapa estático de la
# ruta del viaje). Si está vacía, los mapas y el geocoding se desactivan.
VITE_GEOAPIFY_API_KEY=

# [Opcional] URL de la app admin global (redirect del login si el rol es
# super_admin). Default: http://localhost:5174
VITE_ADMIN_URL=http://localhost:5174

# [Opcional] URL de la app branch (redirect del login si el rol es admin de
# sucursal). Default: http://localhost:5175
VITE_BRANCH_URL=http://localhost:5175

# [Opcional] URL de la app rider. Default: http://localhost:5176
VITE_RIDER_URL=http://localhost:5176

# [Opcional] Si es true, RequireAuth mockea la sesión como rider (no redirige al
# login). Default: false
VITE_MOCK_AUTH=false
