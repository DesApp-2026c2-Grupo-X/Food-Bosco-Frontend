# URL de la app de auth (RequireAuth redirige acá si no hay sesión)
VITE_AUTH_URL=http://localhost:5175

# API key de Geoapify para el mapa estático de seguimiento de pedidos
VITE_GEOAPIFY_API_KEY=

# Si es true, RequireAuth mockea la sesión (no redirige al login). Para builds nativas.
VITE_MOCK_AUTH=false
