# URL del servidor de backend (GraphQL gateway)
VITE_API_URL=http://localhost:4000

# URL de la app admin (el login redirige acá si el usuario es admin)
VITE_ADMIN_URL=http://localhost:5174

# URL de la app branch (el login redirige acá si el usuario es admin de sucursal)
VITE_BRANCH_URL=http://localhost:5175

# URL de la app rider (el login redirige acá si el usuario es repartidor)
VITE_RIDER_URL=http://localhost:5176

# API key de Geoapify para el mapa estático de seguimiento de pedidos
VITE_GEOAPIFY_API_KEY=

# Si es true, RequireAuth mockea la sesión (no redirige al login). Para builds nativas.
VITE_MOCK_AUTH=false

# Si es true, la home usa el feed personalizado del backend (`homeFeed`) y deja
# el cálculo local sólo como fallback.
VITE_HOME_FEED=false

# Si es false, oculta badges de promociones y la página de promociones en la UI.
# El backend debe estar desplegado antes de activar esta feature.
VITE_PRODUCT_PROMOTIONS=true
